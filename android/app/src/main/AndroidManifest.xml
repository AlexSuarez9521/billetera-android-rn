<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sin esto getPackageInfo devuelve NameNotFoundException para cualquier paquete y la
         detección de root por gestores instalados no sirve de nada desde Android 11. -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
    </queries>

    <!-- allowBackup apaga el respaldo en la nube, pero desde Android 12 la transferencia entre
         dispositivos se lleva igual los SharedPreferences; las reglas la dejan por fuera. -->
    <application
      android:name=".BilleteraApp"
      android:allowBackup="false"
      android:dataExtractionRules="@xml/reglas_extraccion"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="true"
      android:theme="@style/AppTheme">

      <activity
        android:name=".splash.SplashActivity"
        android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
        android:exported="true"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <activity
        android:name=".bundles.LoginActivity"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:exported="false"
        android:windowSoftInputMode="adjustResize" />

      <activity
        android:name=".bundles.HomeActivity"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:exported="false"
        android:windowSoftInputMode="adjustResize" />

      <activity
        android:name=".bundles.TransferenciaActivity"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:exported="false"
        android:windowSoftInputMode="adjustResize" />

      <activity
        android:name=".bundles.MovimientosActivity"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:exported="false"
        android:windowSoftInputMode="adjustResize" />

      <activity
        android:name=".error.ErrorActivity"
        android:exported="false" />

    </application>
</manifest>
